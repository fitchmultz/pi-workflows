{
  "name": "@fitchmultz/pi-workflows",
  "version": "0.2.5",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "workflows",
    "recipes"
  ],
  "files": [
    "resources",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "reference/workflows/LICENSE"
  ],
  "pi": {
    "extensions": [
      "./resources/extensions/pi-workflows/index.ts"
    ],
    "skills": [
      "./resources/skills"
    ],
    "prompts": [
      "./resources/prompts"
    ]
  },
  "subagents": {
    "agents": [
      "resources/agents"
    ]
  },
  "type": "module",
  "license": "MIT",
  "description": "Pi-native recipe workflows and scripted agent()/pipeline() runtime",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-workflows.git"
  },
  "homepage": "https://github.com/fitchmultz/pi-workflows#readme",
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-workflows/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:agent": "oxlint --deny-warnings --format=agent .",
    "lint:fix": "oxlint --fix .",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:compat": "npm run check && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^24.13.3",
    "@xterm/headless": "6.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typebox": "1.3.27",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
